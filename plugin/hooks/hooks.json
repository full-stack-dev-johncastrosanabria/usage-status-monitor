{
  "description": "Tells the session when its account goes over the usage threshold or another account was selected, and tells `usage claude` which conversation runs and whether Claude is answering, so it can switch accounts between replies.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "usage notice",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "usage notice",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "usage notice",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
