<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Windows Forms only for the tray icon (NotifyIcon); WPF has none. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Lets `dotnet build` / `dotnet publish` run on Linux and macOS too. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- WFAC010: the manifest declares DPI awareness on purpose, WPF reads it from there. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <AssemblyName>UsageMonitor</AssemblyName>
    <RootNamespace>UsageMonitor</RootNamespace>
    <Product>usage-monitor</Product>
    <Version>0.1.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <IconFile>$(MSBuildThisFileDirectory)..\..\assets\icon.ico</IconFile>
  </PropertyGroup>

  <!-- The icon is produced separately (scripts/make-icon.sh); without it the tray draws its own. -->
  <PropertyGroup Condition="Exists('$(IconFile)')">
    <ApplicationIcon>$(IconFile)</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(IconFile)')">
    <Resource Include="$(IconFile)" Link="icon.ico" />
  </ItemGroup>

  <!-- `dotnet publish -c Release -r win-x64` (or win-arm64) gives one self-contained exe. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Their implicit usings clash with WPF's (Application, Button, Color…). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
